# Copy this file to .env.local (or .env) and fill in your real key.
# Never commit the real .env file — it is already excluded in .gitignore.
#
# Get a free Gemini API key (no credit card required) at:
# https://aistudio.google.com/app/apikey

GEMINI_API_KEY=

# Optional — override the default model (gemini-2.5-flash). Only needed if
# you want to try a different Gemini model (e.g. a newer 3.x Flash preview,
# or gemini-2.5-flash-lite for lower cost/latency).
GEMINI_MODEL=
